# Frontend Environment Variables
# Copy this file to .env and fill in the values before starting the dev server.

# ── API Base URL ──────────────────────────────────────────────────────────────
# Development (local backend):
#   VITE_API_URL=http://localhost:5000/api
# Production (your deployed backend URL — no trailing slash):
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
