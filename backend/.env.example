# Backend Environment Variables
# Copy this file to .env and fill in the values before starting the server.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Node Environment ──────────────────────────────────────────────────────────
# Set to "production" on your hosting platform (Render, Railway, etc.)
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local (development only):
#   MONGO_URI=mongodb://127.0.0.1:27017/prep-master
# MongoDB Atlas (production — required for deployment):
#   MONGO_URI=mongodb+srv://<username>:<password>@cluster.xxxxx.mongodb.net/prep-master?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/prep-master

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -base64 64)
JWT_SECRET=prep-master-local-dev-secret-change-in-production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development:
#   CLIENT_URL=http://localhost:5173
# Production (your deployed frontend URL, no trailing slash):
#   CLIENT_URL=https://your-app.vercel.app
# Multiple frontend URLs are supported with a comma-separated list:
#   CLIENT_URLS=https://your-app.vercel.app,https://your-app-git-main-yourteam.vercel.app
CLIENT_URL=http://localhost:5173
